# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas Connection URI (Free M0 Sandbox cluster)
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/whatsapp_bot?retryWrites=true&w=majority
MONGODB_URI=

# Admin Dashboard Password (used to log into the web control panel)
ADMIN_PASSWORD=admin123

# Web Server Port (Render sets this automatically)
PORT=3000

# Optional: Path to Chrome/Chromium if running on custom Linux server
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
